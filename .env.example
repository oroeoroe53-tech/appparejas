# ---------- Public (safe to expose to the browser) ----------
# Supabase project URL and anon (publishable) key: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site origin, no trailing slash (used for invitation links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# VAPID public key (generate the pair with `npm run vapid`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------- Server only (NEVER prefix with NEXT_PUBLIC_, never commit) ----------
# Supabase service-role key: used only to read push subscriptions and delete accounts
SUPABASE_SERVICE_ROLE_KEY=
# VAPID private key + contact (a mailto: or https: URL)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
